{
  "functions": {
    "api/haneda-cam.js": { "regions": ["hnd1"] },
    "api/yaesu-cam.js":  { "regions": ["hnd1"] }
  },
  "crons": [
    {
      "path": "/api/ships",
      "schedule": "0 21 * * *"
    },
    {
      "path": "/api/events",
      "schedule": "0 20 * * *"
    }
  ],
  "rewrites": [
    { "source": "/app", "destination": "/app.html" },
    { "source": "/qr", "destination": "/qr.html" },
    { "source": "/", "destination": "/index.html" },
    { "source": "/api/stripe-checkout", "destination": "/api/stripe?action=checkout" },
    { "source": "/api/stripe-portal", "destination": "/api/stripe?action=portal" },
    { "source": "/api/stripe-webhook", "destination": "/api/stripe?action=webhook" },
    { "source": "/api/event-cancel", "destination": "/api/events?action=cancel" }
  ],
  "headers": [
    {
      "source": "/sw.js",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" },
        { "key": "Service-Worker-Allowed", "value": "/" }
      ]
    },
    {
      "source": "/app.html",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }
      ]
    },
    {
      "source": "/app",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }
      ]
    },
    {
      "source": "/manifest.json",
      "headers": [
        { "key": "Content-Type", "value": "application/manifest+json" }
      ]
    }
  ]
}
